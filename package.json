{
  "name": "morning-brief",
  "private": true,
  "type": "module",
  "description": "Daily AI/startup morning brief: JSON data updated by an agent, rendered as a mobile-first React site.",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "vite build --configLoader native",
    "preview": "vite preview",
    "brief": "python3 scripts/create_morning_brief.py",
    "doctor": "python3 scripts/create_morning_brief.py --preflight",
    "report": "python3 scripts/create_morning_brief.py --report-only",
    "fetch:public": "python3 scripts/fetch_public_sources.py",
    "fetch:x": "node scripts/fetch_x_sources.cjs",
    "fetch:x:login": "node scripts/fetch_x_sources.cjs --credential-login",
    "setup:x-auth": "node scripts/fetch_x_sources.cjs --setup --browser-channel chromium"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@tailwindcss/vite": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.60.0",
    "vite": "^6.0.0"
  }
}
