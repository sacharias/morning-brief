.DS_Store

# Local runtime noise
*.log
logs/*
tmp/*

# Local-only state. Keep directory placeholders tracked.
state/*
!state/.gitkeep
# The idea ledger is content, not runtime noise — it must persist in git.
!state/idea_ledger.json

# Generated reports. Keep directory placeholders tracked.
reports/*
!reports/.gitkeep

# Secrets and local environment files
.env
.env.*
!.env.example

# Build output
dist/

# Common tool caches
node_modules/
.venv/
__pycache__/
.pytest_cache/
